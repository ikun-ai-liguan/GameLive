# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 中 backend 的 DB_HOST 会被强制设为 mysql（其余变量从 .env 读取）。

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gamelive
DB_USER=root
DB_PASS=root

# ---------- Redis（可选，使用 --profile cache 启动） ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- JWT ----------
# 生产环境务必替换；HS256 密钥至少 32 字节（下面示例值 47 字符）
JWT_SECRET=gamelive-local-development-secret-key-change-me
JWT_EXPIRE_HOURS=24

# ---------- 跨域 ----------
# 逗号分隔；* 表示允许所有来源
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- 直播流地址 ----------
# 与 docker/srs.conf 对应：RTMP 1935，HTTP-FLV 8081
RTMP_PUSH_PREFIX=rtmp://localhost:1935/live/
FLV_PREFIX=http://localhost:8081/live/
